{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Docky",
  "version": "0.1.0",
  "identifier": "com.gandariastudio.docky",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Docky",
        "url": "index.html",
        "width": 720,
        "height": 132,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "focus": true,
        "acceptFirstMouse": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 16
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "copyright": "© 2026 Donny Ridwan. Lisensi MIT.",
    "shortDescription": "Rapikan Mac dengan satu klik.",
    "longDescription": "Docky menjalankan preset: app di luar preset ditutup dengan sopan, app preset dibuka, dan isi dock diganti.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "entitlements": null
    }
  }
}
